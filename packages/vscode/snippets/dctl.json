  "RGB to HSV": {
    "prefix": "rgb2hsv",
    "body": [
      "__DEVICE__ float3 rgb2hsv(float3 rgb)",
      "{",
      "\tfloat r = rgb.x, g = rgb.y, b = rgb.z;",
      "\tfloat maxc = _fmaxf(_fmaxf(r, g), b);",
      "\tfloat minc = _fminf(_fminf(r, g), b);",
      "\tfloat delta = maxc - minc;",
      "\t",
      "\tfloat h = 0.0f;",
      "\tif (delta > 0.0f) {",
      "\t\tif (maxc == r) {",
      "\t\t\th = (g - b) / delta;",
      "\t\t} else if (maxc == g) {",
      "\t\t\th = 2.0f + (b - r) / delta;",
      "\t\t} else {",
      "\t\t\th = 4.0f + (r - g) / delta;",
      "\t\t}",
      "\t\th = h / 6.0f;",
      "\t\tif (h < 0.0f) h += 1.0f;",
      "\t}",
      "\t",
      "\tfloat s = (maxc > 0.0f) ? delta / maxc : 0.0f;",
      "\tfloat v = maxc;",
      "\t",
      "\treturn make_float3(h, s, v);",
      "}"
    ],
    "description": "Convert RGB to HSV color space"
  },
  "HSV to RGB": {
    "prefix": "hsv2rgb",
    "body": [
      "__DEVICE__ float3 hsv2rgb(float3 hsv)",
      "{",
      "\tfloat h = hsv.x, s = hsv.y, v = hsv.z;",
      "\t",
      "\tif (s <= 0.0f) {",
      "\t\treturn make_float3(v, v, v);",
      "\t}",
      "\t",
      "\th = h * 6.0f;",
      "\tif (h >= 6.0f) h = 0.0f;",
      "\t",
      "\tint i = (int)h;",
      "\tfloat f = h - (float)i;",
      "\tfloat p = v * (1.0f - s);",
      "\tfloat q = v * (1.0f - s * f);",
      "\tfloat t = v * (1.0f - s * (1.0f - f));",
      "\t",
      "\tswitch (i) {",
      "\t\tcase 0: return make_float3(v, t, p);",
      "\t\tcase 1: return make_float3(q, v, p);",
      "\t\tcase 2: return make_float3(p, v, t);",
      "\t\tcase 3: return make_float3(p, q, v);",
      "\t\tcase 4: return make_float3(t, p, v);",
      "\t\tdefault: return make_float3(v, p, q);",
      "\t}",
      "}"
    ],
    "description": "Convert HSV to RGB color space"
  },
  "sRGB to Linear": {
    "prefix": "srgb2linear",
    "body": [
      "__DEVICE__ float srgb2linear(float x)",
      "{",
      "\treturn (x <= 0.04045f) ? x / 12.92f : _powf((x + 0.055f) / 1.055f, 2.4f);",
      "}",
      "",
      "__DEVICE__ float3 srgb2linear3(float3 rgb)",
      "{",
      "\treturn make_float3(",
      "\t\tsrgb2linear(rgb.x),",
      "\t\tsrgb2linear(rgb.y),",
      "\t\tsrgb2linear(rgb.z)",
      "\t);",
      "}"
    ],
    "description": "Convert sRGB to Linear color space"
  },
  "Linear to sRGB": {
    "prefix": "linear2srgb",
    "body": [
      "__DEVICE__ float linear2srgb(float x)",
      "{",
      "\treturn (x <= 0.0031308f) ? x * 12.92f : 1.055f * _powf(x, 1.0f / 2.4f) - 0.055f;",
      "}",
      "",
      "__DEVICE__ float3 linear2srgb3(float3 rgb)",
      "{",
      "\treturn make_float3(",
      "\t\tlinear2srgb(rgb.x),",
      "\t\tlinear2srgb(rgb.y),",
      "\t\tlinear2srgb(rgb.z)",
      "\t);",
      "}"
    ],
    "description": "Convert Linear to sRGB color space"
  },
  "Contrast": {
    "prefix": "contrast",
    "body": [
      "// Contrast adjustment around pivot point",
      "float pivot = ${1:0.18f};",
      "${2:rgb}.x = (${2:rgb}.x - pivot) * ${3:contrast} + pivot;",
      "${2:rgb}.y = (${2:rgb}.y - pivot) * ${3:contrast} + pivot;",
      "${2:rgb}.z = (${2:rgb}.z - pivot) * ${3:contrast} + pivot;"
    ],
    "description": "Contrast adjustment around pivot point"
  },
