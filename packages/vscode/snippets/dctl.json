  "LogC to Linear": {
    "prefix": "logc2linear",
    "body": [
      "// ARRI LogC3 to Linear (EI 800)",
      "__DEVICE__ float logc2linear(float x)",
      "{",
      "\tconst float cut = 0.010591f;",
      "\tconst float a = 5.555556f;",
      "\tconst float b = 0.052272f;",
      "\tconst float c = 0.247190f;",
      "\tconst float d = 0.385537f;",
      "\tconst float e = 5.367655f;",
      "\tconst float f = 0.092809f;",
      "\t",
      "\treturn (x > e * cut + f) ? (_powf(10.0f, (x - d) / c) - b) / a : (x - f) / e;",
      "}",
      "",
      "__DEVICE__ float3 logc2linear3(float3 rgb)",
      "{",
      "\treturn make_float3(",
      "\t\tlogc2linear(rgb.x),",
      "\t\tlogc2linear(rgb.y),",
      "\t\tlogc2linear(rgb.z)",
      "\t);",
      "}"
    ],
    "description": "Convert ARRI LogC3 to Linear"
  },
  "Linear to LogC": {
    "prefix": "linear2logc",
    "body": [
      "// Linear to ARRI LogC3 (EI 800)",
      "__DEVICE__ float linear2logc(float x)",
      "{",
      "\tconst float cut = 0.010591f;",
      "\tconst float a = 5.555556f;",
      "\tconst float b = 0.052272f;",
      "\tconst float c = 0.247190f;",
      "\tconst float d = 0.385537f;",
      "\tconst float e = 5.367655f;",
      "\tconst float f = 0.092809f;",
      "\t",
      "\treturn (x > cut) ? c * _log10f(a * x + b) + d : e * x + f;",
      "}",
      "",
      "__DEVICE__ float3 linear2logc3(float3 rgb)",
      "{",
      "\treturn make_float3(",
      "\t\tlinear2logc(rgb.x),",
      "\t\tlinear2logc(rgb.y),",
      "\t\tlinear2logc(rgb.z)",
      "\t);",
      "}"
    ],
    "description": "Convert Linear to ARRI LogC3"
  },
