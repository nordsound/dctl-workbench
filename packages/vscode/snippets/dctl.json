  "__DEVICE__ Transform Texture (float3)": {
    "prefix": "__DEVICE__",
    "body": [
      "__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,",
      "\t__TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)",
      "{",
      "\tfloat r = _tex2D(p_TexR, p_X, p_Y);",
