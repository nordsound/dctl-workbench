      "\t__TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB, __TEXTURE__ p_TexA)",
      "{",
      "\tfloat r = _tex2D(p_TexR, p_X, p_Y);",
