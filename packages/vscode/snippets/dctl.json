  "RGB to HSL": {
    "prefix": "rgb2hsl",
    "body": [
      "__DEVICE__ float3 rgb2hsl(float3 rgb)",
      "{",
      "\tfloat r = rgb.x, g = rgb.y, b = rgb.z;",
      "\tfloat maxc = _fmaxf(_fmaxf(r, g), b);",
      "\tfloat minc = _fminf(_fminf(r, g), b);",
      "\tfloat l = (maxc + minc) * 0.5f;",
      "\t",
      "\tif (maxc == minc) {",
      "\t\treturn make_float3(0.0f, 0.0f, l);",
      "\t}",
      "\t",
      "\tfloat delta = maxc - minc;",
      "\tfloat s = (l > 0.5f) ? delta / (2.0f - maxc - minc) : delta / (maxc + minc);",
      "\t",
      "\tfloat h = 0.0f;",
      "\tif (maxc == r) {",
      "\t\th = (g - b) / delta + (g < b ? 6.0f : 0.0f);",
      "\t} else if (maxc == g) {",
      "\t\th = (b - r) / delta + 2.0f;",
      "\t} else {",
      "\t\th = (r - g) / delta + 4.0f;",
      "\t}",
      "\th /= 6.0f;",
      "\t",
      "\treturn make_float3(h, s, l);",
      "}"
    ],
    "description": "Convert RGB to HSL color space"
  },
  "HSL to RGB": {
    "prefix": "hsl2rgb",
    "body": [
      "__DEVICE__ float hue2rgb(float p, float q, float t)",
      "{",
      "\tif (t < 0.0f) t += 1.0f;",
      "\tif (t > 1.0f) t -= 1.0f;",
      "\tif (t < 1.0f / 6.0f) return p + (q - p) * 6.0f * t;",
      "\tif (t < 0.5f) return q;",
      "\tif (t < 2.0f / 3.0f) return p + (q - p) * (2.0f / 3.0f - t) * 6.0f;",
      "\treturn p;",
      "}",
      "",
      "__DEVICE__ float3 hsl2rgb(float3 hsl)",
      "{",
      "\tfloat h = hsl.x, s = hsl.y, l = hsl.z;",
      "\t",
      "\tif (s <= 0.0f) {",
      "\t\treturn make_float3(l, l, l);",
      "\t}",
      "\t",
      "\tfloat q = (l < 0.5f) ? l * (1.0f + s) : l + s - l * s;",
      "\tfloat p = 2.0f * l - q;",
      "\t",
      "\treturn make_float3(",
      "\t\thue2rgb(p, q, h + 1.0f / 3.0f),",
      "\t\thue2rgb(p, q, h),",
      "\t\thue2rgb(p, q, h - 1.0f / 3.0f)",
      "\t);",
      "}"
    ],
    "description": "Convert HSL to RGB color space"
  },
  "Color Temperature": {
    "prefix": "temperature",
    "body": [
      "// Color temperature adjustment (warm/cool)",
      "// temperature: negative = cooler (blue), positive = warmer (orange)",
      "float temp = ${1:temperature};",
      "${2:rgb}.x += temp * 0.1f;",
      "${2:rgb}.z -= temp * 0.1f;"
    ],
    "description": "Simple color temperature adjustment"
  },
