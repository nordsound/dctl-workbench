  "__DEVICE__ Transition": {
    "prefix": "__DEVICE__",
    "body": [
      "__DEVICE__ float4 transition(int p_Width, int p_Height, int p_X, int p_Y,",
      "\t__TEXTURE__ p_FromTexR, __TEXTURE__ p_FromTexG, __TEXTURE__ p_FromTexB, __TEXTURE__ p_FromTexA,",
      "\t__TEXTURE__ p_ToTexR, __TEXTURE__ p_ToTexG, __TEXTURE__ p_ToTexB, __TEXTURE__ p_ToTexA)",
      "{",
      "\tfloat4 from = make_float4(_tex2D(p_FromTexR, p_X, p_Y), _tex2D(p_FromTexG, p_X, p_Y), _tex2D(p_FromTexB, p_X, p_Y), _tex2D(p_FromTexA, p_X, p_Y));",
      "\tfloat4 to = make_float4(_tex2D(p_ToTexR, p_X, p_Y), _tex2D(p_ToTexG, p_X, p_Y), _tex2D(p_ToTexB, p_X, p_Y), _tex2D(p_ToTexA, p_X, p_Y));",
      "\tfloat t = TRANSITION_PROGRESS;",
      "\t$0",
      "\treturn make_float4(",
      "\t\t_mix(from.x, to.x, t),",
      "\t\t_mix(from.y, to.y, t),",
      "\t\t_mix(from.z, to.z, t),",
      "\t\t_mix(from.w, to.w, t)",
      "\t);",
      "}"
    ],
    "description": "transition - Transition effect entry point (official signature)"
  },
