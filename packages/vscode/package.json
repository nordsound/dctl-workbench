{
  "name": "dctl-workbench",
  "displayName": "DCTL Workbench",
  "description": "DCTL development environment with color pipeline for VSCode",
  "version": "0.3.0",
  "publisher": "nordsound",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nordsound/dctl-workbench"
  },
  "private": true,
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "dctl",
    "davinci",
    "resolve",
    "color",
    "grading",
    "aces",
    "openexr",
    "exr"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "dctl",
        "aliases": [
          "DCTL",
          "DaVinci Color Transform Language"
        ],
        "extensions": [
          ".dctl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dctl",
        "scopeName": "source.dctl",
        "path": "./syntaxes/dctl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "dctl",
        "path": "./snippets/dctl.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "dctlWorkbench.exrEditor",
        "displayName": "EXR Viewer",
        "selector": [
          {
            "filenamePattern": "*.exr"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dctlWorkbench.openPreview",
        "title": "Preview in EXR Viewer",
        "category": "DCTL Workbench",
        "icon": "$(eye)"
      },
      {
        "command": "dctlWorkbench.copyToResolve",
        "title": "Copy to DaVinci Resolve",
        "category": "DCTL Workbench",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dctlWorkbench.toggleResolveLog",
        "title": "Toggle DaVinci Resolve Log Monitor",
        "category": "DCTL Workbench"
      }
    ],
    "configuration": [
      {
        "title": "EXR Viewer",
        "properties": {
          "dctlWorkbench.exr_viewer.defaultWorkingColorSpace": {
            "type": "string",
            "default": "ACEScct",
            "enum": [
              "ACES2065-1",
              "ACEScg",
              "ACEScc",
              "ACEScct",
              "linear_sRGB"
            ],
            "enumItemLabels": [
              "ACES2065-1 (AP0)",
              "ACEScg (AP1)",
              "ACEScc (Log)",
              "ACEScct (Log)",
              "Linear sRGB"
            ],
            "description": "Default working color space when opening EXR files (can be changed per viewer)"
          },
          "dctlWorkbench.exr_viewer.defaultExportCompression": {
            "type": "string",
            "default": "PIZ",
            "enum": [
              "NONE",
              "RLE",
              "ZIPS",
              "ZIP",
              "PIZ",
              "PXR24",
              "B44",
              "B44A",
              "DWAA",
              "DWAB"
            ],
            "enumItemLabels": [
              "NONE (uncompressed)",
              "RLE (lossless)",
              "ZIPS (lossless, single scanline)",
              "ZIP (lossless, 16 scanlines)",
              "PIZ (lossless, wavelet)",
              "PXR24 (lossy, 24-bit)",
              "B44 (lossy, fixed rate)",
              "B44A (lossy, fixed rate + flat optimization)",
              "DWAA (lossy, small blocks)",
              "DWAB (lossy, large blocks)"
            ],
            "description": "Default EXR export compression method"
          }
        }
      },
      {
        "title": "Editor",
        "properties": {
          "dctlWorkbench.editor.diagnostics": {
            "type": "boolean",
            "default": true,
            "description": "Enable DCTL syntax checking and diagnostics"
          },
          "dctlWorkbench.editor.diagnosticsDebounceMs": {
            "type": "number",
            "default": 500,
            "description": "Debounce time for diagnostics update (ms)"
          },
          "dctlWorkbench.editor.nagaValidation": {
            "type": "boolean",
            "default": true,
            "description": "Enable Naga (WGSL) validation in addition to syntax checking"
          },
          "dctlWorkbench.editor.resolveDctlDirectory": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to DaVinci Resolve DCTL directory. Leave empty to use the OS default:\n- **macOS**: `/Library/Application Support/Blackmagic Design/DaVinci Resolve/LUT/DCTL/`\n- **Windows**: `C:\\\\ProgramData\\\\Blackmagic Design\\\\DaVinci Resolve\\\\Support\\\\LUT\\\\DCTL\\\\`\n- **Linux**: `/opt/resolve/LUT/DCTL/`"
          }
        }
      },
      {
        "title": "DaVinci Resolve",
        "properties": {
          "dctlWorkbench.resolve.logDirectory": {
            "type": "string",
            "default": "",
            "markdownDescription": "Path to DaVinci Resolve logs directory. Leave empty to use the OS default:\n- **macOS**: `~/Library/Application Support/Blackmagic Design/DaVinci Resolve/logs/`\n- **Windows**: `%APPDATA%\\\\Blackmagic Design\\\\DaVinci Resolve\\\\Support\\\\logs\\\\`\n- **Linux**: `~/.local/share/DaVinciResolve/logs/`"
          }
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .dctl",
          "command": "dctlWorkbench.openPreview",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .dctl",
          "command": "dctlWorkbench.copyToResolve",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package:build",
    "package:build": "npm run copy-wasm && node esbuild.config.mjs --production",
    "compile": "tsc -p ./ && npm run copy-wasm && npm run bundle",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-wasm": "mkdir -p out/wasm && cp -r ../../wasm/* out/wasm/ && cp ../../node_modules/web-tree-sitter/web-tree-sitter.wasm out/wasm/",
    "bundle": "node esbuild.config.mjs",
    "clean": "rm -rf out",
    "package": "vsce package",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register 'src/test/unit/**/*.test.ts'",
    "test:unit": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register 'src/test/unit/**/*.test.ts'",
    "compile:test": "tsc -p tsconfig.test.json",
    "pretest:integration": "rm -rf out/src/test && npm run compile && npm run compile:test",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "test:integration:legacy": "node ./out/src/test/runTest.js"
  },
  "dependencies": {
    "@dctl-workbench/core": "*",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "@types/proxyquire": "^1.3.31",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.27.3",
    "glob": "^13.0.2",
    "mocha": "^11.7.5",
    "proxyquire": "^2.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  }
}
