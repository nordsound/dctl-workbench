{
  "name": "@dctl-workbench/cli",
  "version": "0.2.0",
  "private": true,
  "description": "CLI tool for applying DCTL effects to EXR images using WebGPU",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "bin": {
    "dctlw": "./out/index.js"
  },
  "scripts": {
    "build": "tsc -p ./",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "rm -rf out",
    "start": "node out/index.js",
    "pretest": "rm -rf out/test && npm run build && npm run build:test",
    "test": "c8 --include 'out/**/*.js' --exclude 'out/test/**/*.js' mocha 'out/test/**/*.test.js'",
    "test:unit": "mocha 'out/test/*.test.js'",
    "test:integration": "mocha 'out/test/integration/**/*.test.js'",
    "coverage": "c8 report --reporter=text --reporter=html"
  },
  "dependencies": {
    "@dctl-workbench/core": "*",
    "commander": "^14.0.3",
    "webgpu": "^0.3.8"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "@webgpu/types": "^0.1.69",
    "c8": "^10.1.3",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/test/**/*.ts"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
