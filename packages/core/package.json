{
  "name": "@dctl-workbench/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core runtime library for DCTL compilation and processing",
  "main": "out/index.js",
  "types": "out/index.d.ts",
  "scripts": {
    "build": "tsc -p ./",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "rm -rf out",
    "watch": "tsc -p ./ --watch",
    "pretest": "npm run build && npm run build:test",
    "test": "c8 --include 'out/**/*.js' --exclude 'out/test/**/*.js' mocha 'out/test/**/*.test.js'",
    "test:unit": "mocha 'out/test/**/*.test.js'",
    "coverage": "c8 report --reporter=text --reporter=html"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.13",
    "c8": "^10.1.3",
    "mocha": "^11.7.5",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "nyc": {
    "extension": [
      ".js"
    ],
    "include": [
      "out/**/*.js"
    ],
    "exclude": [
      "out/test/**/*.js"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true,
    "check-coverage": false,
    "lines": 85,
    "functions": 85,
    "branches": 80,
    "statements": 85
  },
  "files": [
    "out/**/*"
  ]
}
